{
  "name": "artemis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "check": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p shell/tsconfig.json",
    "test": "bun test --timeout 60000 tests",
    "build": "bun run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "artemis": "bun run scripts/artemis.ts"
  },
  "dependencies": {
    "@arwes/react": "1.0.0-alpha.23",
    "@cosmos.gl/graph": "3.4.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.5.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "trustedDependencies": [
    "electron"
  ]
}
